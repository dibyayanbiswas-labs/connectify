{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Root-level files only (prettier.config.js etc.). Each app/package has its own tsconfig.
  "extends": "./packages/typescript-config/base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": ["*.js", "*.mjs", "*.cjs", "*.ts"]
}
