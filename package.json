{
  "name": "connectify",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:dev": "bash scripts/setup.sh",
    "build": "dotenv -v NODE_ENV=production -- turbo build",
    "dev": "dotenv -- turbo dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "dotenv -- turbo run test",
    "format": "prettier --write .",
    "db:up": "docker compose up -d postgresdb",
    "db:down": "docker compose down",
    "db:generate": "dotenv -- turbo db:generate",
    "db:migrate": "dotenv -- turbo db:migrate",
    "db:check": "dotenv -- turbo db:check --filter=@repo/database",
    "format:check": "prettier --check ."
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dotenv-cli": "^11.1.0",
    "prettier": "^3.10.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
