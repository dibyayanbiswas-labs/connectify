# =============================================================================
# Connectify environment template
# =============================================================================
# Copy to .env (`pnpm setup:dev` does this) and fill in the empty values.
# .env is git-ignored. Only this template is committed, and it must never
# contain real secrets.
#
# Production: the values come from each platform's secret store (Vercel for
# web, Railway/Render for api, Neon for the DB), never from a file.
#
# Each app/package validates the variables it reads with Zod at boot and stops
# if one is missing (architecture.md §7). Keep this file in sync with those
# schemas: add a variable here when you add it to an env.ts.
#
# Tags:
#   [required]  the app will not start without it
#   [optional]  has a default in code, or belongs to a feature not built yet.
#               Optional variables are left commented out.
#   (api) / (web) / (database) / (all) = which part reads it
#
# Generate secrets with:  openssl rand -base64 32
# =============================================================================


# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# (all) [optional] development | test | production. Defaults to development.
# Hosting platforms set this themselves in production.
NODE_ENV=development


# -----------------------------------------------------------------------------
# Database: Postgres + pgvector (Docker locally, Neon in production)
# -----------------------------------------------------------------------------
# Neon gives two connection strings for the same database:
#   - pooled   (host has "-pooler"): goes through PgBouncer and handles many
#              short connections. The running API uses this one.
#   - unpooled (direct host): a plain session connection. Use it for
#              migrations and drizzle-kit, which need session features
#              (advisory locks, prepared statements) that PgBouncer's
#              transaction mode breaks.
# Locally there is no pooler, so both point at the docker-compose container.
#
# Neon example:
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
#   DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require

# (database, api) [required] Pooled URL used at runtime.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dev

# (database) [optional] Direct URL for drizzle-kit migrate/generate/studio.
# Falls back to DATABASE_URL when empty (fine locally, where there is no pooler).
# Set it on Neon: its host must NOT contain "-pooler".
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5432/dev

# (database) [optional] Max connections in the node-postgres pool (1-100).
# Keep it small: there is one API instance, and Neon's free tier caps
# connections.
# DB_POOL_MAX=10

# (database) [optional] Close a pooled connection after it is idle this long.
# DB_IDLE_TIMEOUT_MS=30000

# (database) [optional] Give up acquiring a connection after this long instead
# of hanging (also covers a Neon compute waking from scale-to-zero).
# DB_CONNECTION_TIMEOUT_MS=5000

# (database) [optional] Server-side limit per query. 0 = no limit.
# DB_STATEMENT_TIMEOUT_MS=15000

# (database) [optional] Log SQL queries (true/false). Development only:
# queries can contain user data, and the logging rules forbid that in prod.
# DB_LOG_QUERIES=false


# -----------------------------------------------------------------------------
# URLs and ports
# -----------------------------------------------------------------------------
# The browser only talks to web. Web proxies /api/trpc to api, so the browser
# sees a single origin (no CORS, simple cookies).

# (web, api) [required] Public URL of the web app. Used for OAuth redirects,
# links in emails, and the Origin check on mutations (CSRF).
APP_URL=http://localhost:3000

# (api) [required] Public URL of the API. Google/Corsair webhooks and OAuth
# callbacks must reach it, so in production it needs to be a public HTTPS URL
# (ADR-5).
API_URL=http://localhost:4000

# (web) [required] Where web's server-side /api/trpc proxy forwards to. Same as
# API_URL locally. In docker compose use the service name
# (e.g. http://api:4000), or the platform's private URL in production.
API_INTERNAL_URL=http://localhost:4000

# (api) [optional] Port the Express server listens on. Railway/Render inject
# PORT themselves, so the API should read PORT first, then API_PORT.
API_PORT=4000

# (web) [optional] Port for `next dev` / `next start`. Defaults to 3000.
# WEB_PORT=3000

# (web) [optional] Browser-visible copy of APP_URL. NEXT_PUBLIC_* values are
# inlined into the client bundle at build time, so never put secrets here.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Auth: Google sign-in (identity only, ADR-3)
# -----------------------------------------------------------------------------
# Scopes: openid email profile. Gmail/Calendar access is a separate consent
# that goes through Corsair (see below), not through this client.
# Create the client at Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID (type "Web application"). Use a separate client for
# production with the production redirect URI.

# (api) [required]
GOOGLE_CLIENT_ID=
# (api) [required]
GOOGLE_CLIENT_SECRET=
# (api) [required] Must match an "Authorized redirect URI" on the client
# exactly. Goes through web's origin so the session cookie is first-party.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback


# -----------------------------------------------------------------------------
# Sessions / JWT
# -----------------------------------------------------------------------------
# Short-lived access token + longer refresh token, both in httpOnly cookies.
# sessions.token_version lets us revoke every refresh token for a user.
# Use different secrets for access and refresh tokens, and different values
# per environment. Changing a secret signs out every user.

# (api) [required] At least 32 random bytes.
JWT_ACCESS_SECRET=
# (api) [required] At least 32 random bytes, different from the access secret.
JWT_REFRESH_SECRET=
# (api) [optional] Token lifetimes as durations (e.g. 15m, 1h, 30d).
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d

# (api) [optional] Cookie domain. Leave unset to scope cookies to the exact
# host, which is what you want when web proxies to api.
# COOKIE_DOMAIN=


# -----------------------------------------------------------------------------
# Cloudflare Turnstile: CAPTCHA / bot protection
# -----------------------------------------------------------------------------
# Protects the endpoints bots would abuse: starting sign-in, and expensive AI
# calls such as agent chat. The browser widget gets a one-time token, and the
# API checks it with Cloudflare's siteverify endpoint before doing the work.
# Create a widget at dash.cloudflare.com → Turnstile → Add widget. Add
# "localhost" and the production domain to its hostnames.
#
# Local dev / CI: Cloudflare publishes test keys that always pass, so no
# account is needed (the values below). Other test keys always fail or always
# show an interactive challenge; see the Turnstile docs, "Testing".
# Production: replace both values with the real keys.

# (web) [required] Public site key that renders the widget. Fine in the
# browser bundle.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# (api) [required] Secret key for server-side siteverify. API only, never
# NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA


# -----------------------------------------------------------------------------
# Corsair: Gmail + Google Calendar integration, webhooks, MCP
# -----------------------------------------------------------------------------
# Only apps/api talks to Corsair (architecture.md §1). It keeps the Gmail /
# Calendar OAuth tokens in its own tables, encrypted with the KEK below.
# NOTE: check the variable names and the Google client setup against the
# Corsair SDK docs when wiring it up. The names below are this project's
# own, not the SDK's.

# (api) [required] Key-encryption key for stored OAuth tokens. Lives only in
# the API's env, never in web. Losing it makes every stored token unreadable
# (users must reconnect), so back it up in the secret store.
CORSAIR_KEK=

# (api) [required] Google OAuth client Corsair uses for the Gmail/Calendar
# consent (scopes: gmail.readonly, gmail.send, calendar.events). Can be the
# same Google Cloud project as sign-in. A separate client keeps the two
# consents cleanly apart.
CORSAIR_GOOGLE_CLIENT_ID=
CORSAIR_GOOGLE_CLIENT_SECRET=
# (api) [required] Callback for the Gmail/Calendar consent.
CORSAIR_GOOGLE_REDIRECT_URI=http://localhost:4000/integrations/google/callback

# (api) [optional, Phase 7] Secret used to verify incoming webhooks. Webhooks
# need a public URL, so locally use a tunnel (cloudflared/ngrok) and point
# API_URL at it.
# CORSAIR_WEBHOOK_SECRET=

# (api) [optional, Phase 8] Enables the MCP endpoint with its permission tool.
# MCP_ENABLED=false


# -----------------------------------------------------------------------------
# AI: Anthropic (Claude)
# -----------------------------------------------------------------------------
# Claude is the only LLM provider (PRD §4). Model IDs live in config, not code
# (architecture.md §6).

# (api) [required] From console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=

# (api) [optional] Fast tier: summaries, priority, event extraction.
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# (api) [optional] Smart tier: agent chat with tools, reply polishing.
ANTHROPIC_MODEL_SMART=claude-sonnet-5-5

# (api) [optional] Circuit breakers. They stop runaway usage (a looping agent,
# a 5-week backfill), they don't control money. Set the daily cap from the
# limits shown in the Anthropic Console. Past the cap, fall back to snippets +
# heuristics.
AI_DAILY_TOKEN_CAP_PER_USER=200000
AI_AGENT_MAX_ITERATIONS=8


# -----------------------------------------------------------------------------
# Embeddings: local model (ADR-4)
# -----------------------------------------------------------------------------
# Runs inside the API via Transformers.js. No API key, and email text never
# leaves the server. Changing the model means re-embedding the rows whose
# embedding_model differs, and the dimensions must match the vector(384)
# column.

# (api) [optional]
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
# (api) [optional] Must match the pgvector column size.
EMBEDDING_DIMENSIONS=384
# (api) [optional] Where the ~130 MB model download is cached (git-ignored).
# TRANSFORMERS_CACHE=./.cache/transformers


# -----------------------------------------------------------------------------
# Voice: speech-to-text / text-to-speech (PRD "Could" #16, not built yet)
# -----------------------------------------------------------------------------
# Anthropic has no speech API, so voice needs another provider. Uncomment one
# when the feature is built. The browser's Web Speech API is a free fallback
# that needs no key.

# (api) [optional] browser | openai | elevenlabs
# VOICE_PROVIDER=browser

# OpenAI: speech only (gpt-4o-mini-tts for TTS, gpt-4o-mini-transcribe for STT).
# Not used for chat; Claude handles all text generation.
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# ElevenLabs: higher-quality voices, separate free quota.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=


# -----------------------------------------------------------------------------
# Transactional email (optional, not in the MVP)
# -----------------------------------------------------------------------------
# User mail (replies, drafts) is sent from the user's own Gmail through
# Corsair, so the MVP needs no email provider. Only add one for system email
# from the app itself (alerts, a welcome email).

# (api) [optional] resend | smtp
# EMAIL_PROVIDER=resend
# EMAIL_FROM="Connectify <no-reply@your-domain.com>"

# Resend (free tier: 3k emails/month, needs a verified domain).
# RESEND_API_KEY=

# SMTP (local testing with Mailpit/MailHog: host localhost, port 1025).
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=


# -----------------------------------------------------------------------------
# Sync, retention and queue tuning (defaults live in code)
# -----------------------------------------------------------------------------
# Only uncomment to override. Values match architecture.md §3–§5.

# (api) How long cached mail is kept before the nightly purge.
# MAIL_RETENTION_DAYS=35
# (api) Fallback poll for missed webhooks.
# SYNC_FALLBACK_POLL_MINUTES=10
# (api) Brief triggers a background sync when last_synced_at is older than this.
# SYNC_STALE_AFTER_SECONDS=120
# (api) Queue items stuck in "processing" longer than this go back to "failed".
# QUEUE_STALE_PROCESSING_MINUTES=5


# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# (all) [optional] error | warn | info | debug.
# Default: debug in development, info everywhere else.
# LOG_LEVEL=debug

# (all) [optional] pretty | json.
# Default: pretty in development, json everywhere else. Set it to json to see
# production-shaped logs locally (e.g. in the prod-like docker compose).
# LOG_FORMAT=json

# (api) [optional] OpenTelemetry traces (API → Corsair → Anthropic). Leave the
# endpoint unset to turn exporting off. Grafana Cloud and Honeycomb both have
# free tiers with an OTLP endpoint.
# OTEL_SERVICE_NAME=connectify-api
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=


# -----------------------------------------------------------------------------
# Testing (CI / Playwright)
# -----------------------------------------------------------------------------
# (tests) [optional] Target of the prod smoke test (Phase 3+).
# E2E_BASE_URL=http://localhost:3000
# (api) [optional] Use the fake Google provider instead of Corsair. Never
# enable in production.
# USE_FAKE_GOOGLE_PROVIDER=false
