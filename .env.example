# =============================================================================
# Connectify environment template
# =============================================================================
# Copy to .env (`pnpm setup:dev` does this). .env is git-ignored; this template
# is committed and must never contain real secrets. In production the values
# come from each platform's secret store, never from a file.
#
# This file lists only what the code reads today. Each section is added in the
# same commit as the env.ts schema that reads it, so the two can't drift.
# (The drafts for later phases are in git: `git show 181a4ca:.env.example`.)
#
# Tags: [required] the app won't start without it.
#       [optional] has a default in code; left commented out.
#       (all) / (database) / (api) / (web) = which part reads it.
# =============================================================================


# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# (all) [optional] development | test | production. Defaults to development.
# Hosting platforms set this themselves in production.
NODE_ENV=development


# -----------------------------------------------------------------------------
# Database: Postgres + pgvector (Docker locally, Neon in production)
# -----------------------------------------------------------------------------
# Neon gives two connection strings for the same database:
#   - pooled   (host has "-pooler"): goes through PgBouncer. The app uses it.
#   - unpooled (direct host): a plain session connection, for migrations,
#              which need session features PgBouncer's transaction mode breaks.
# Locally there is no pooler, so DATABASE_URL alone is enough.
#
# Neon example:
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
#   DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require

# (database) [required] Pooled URL used at runtime.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dev

# (database) [optional] Direct URL for migrations. Falls back to DATABASE_URL.
# On Neon, set it: its host must NOT contain "-pooler".
# DATABASE_URL_UNPOOLED=


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# (all) [optional] error | warn | info | debug.
# Default: debug in development, info everywhere else.
# LOG_LEVEL=debug

# (all) [optional] pretty | json.
# Default: pretty in development, json everywhere else. Set json to see
# production-shaped logs locally.
# LOG_FORMAT=json
